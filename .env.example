# Copy this file to .env (or set these as Docker environment variables)

# Port the app listens on inside the container
PORT=3000

# Admin login password for the /admin notable-games editor.
# Change this to something private before deploying.
ADMIN_PASSWORD=changeme

# Secret used to sign the admin session cookie. Use a long random string.
SESSION_SECRET=please-change-this-to-a-random-string

# ESPN team ID that should always be pinned at the top of the app.
# 259 = Virginia Tech Hokies (ESPN college-football team id).
FAVORITE_TEAM_ID=259
FAVORITE_TEAM_NAME=Virginia Tech Hokies

# Optional: your self-hosted ncaa-api instance (https://github.com/henrygd/ncaa-api),
# used as a fallback if ESPN's API is unreachable. Leave unset to turn the
# fallback off.
# NCAA_API_BASE=https://ncaa-api.example.com

# NCAA Division/classification for the ncaa-api fallback (fbs, fcs, ii, iii)
NCAA_API_DIVISION=fbs

# How many seconds to cache ESPN/ncaa-api responses before refetching
CACHE_TTL_SECONDS=20

# Optional: override the News tab's RSS feeds (JSON array of {"name","url"}).
# Put private RSS-bridge URLs here, not in source code.
# NEWS_FEEDS_JSON=[{"name":"ESPN","url":"https://example.com/feed.rss"}]

# Optional: turns on the ESPN relay (/espn/...) so BingeBandit's Sports
# section reads ESPN through this tracker's cache. Use a long random string
# and enter the same key in BingeBandit (Server -> Settings -> Sports data).
# RELAY_API_KEY=

# ---- Accounts, alerts and calendar ----
# The site's public address. Used for SSO and calendar links.
# PUBLIC_URL=https://sports.example.com

# Set to false to stop new email/password sign-ups.
# ALLOW_SIGNUP=true

# Single sign-on with Tinyauth (or any OpenID Connect provider). Register
# <PUBLIC_URL>/auth/sso/callback as a trusted redirect URI in Tinyauth.
# SSO_ISSUER=https://auth.example.com
# SSO_CLIENT_ID=cfb-tracker
# SSO_CLIENT_SECRET=
# SSO_LABEL=Tinyauth

# Web push keys for game alerts. Leave unset to generate them once into the
# data folder (vapid.json).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com


# Optional: free CollegeFootballData.com API key (https://collegefootballdata.com/key).
# Turns on the Recruiting page's Transfer Portal, Top Recruits and Class
# Rankings tabs. Recruiting news works without it.
# CFBD_API_KEY=

# Optional: override the Recruiting page's news feeds (JSON array of {"name","url"}).
# Defaults are Google News searches for the transfer portal and recruiting.
# RECRUITING_FEEDS_JSON=[{"name":"On3","url":"https://example.com/feed.rss"}]
